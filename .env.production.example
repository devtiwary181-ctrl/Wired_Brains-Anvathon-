# ==============================================================================
# DISASTERREADY INDIA - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.production on your deployment server and replace placeholder values.
# DO NOT commit real secrets or passwords to version control!
# ==============================================================================

# Application Port & Node Environment
NODE_ENV=production
PORT=5001

# Primary Public Application Origin (Canonical URL)
# For example: https://disasterready.in or https://your-server-domain.com
FRONTEND_URL=https://disasterready.in

# Database Configuration (PostgreSQL 16 + PostGIS)
# When deploying via docker-compose.prod.yml, the host is 'postgres'
POSTGRES_USER=disasterready
POSTGRES_PASSWORD=replace_with_a_secure_random_db_password
POSTGRES_DB=disasterready_db
DATABASE_URL=postgresql://disasterready:replace_with_a_secure_random_db_password@postgres:5432/disasterready_db?schema=public

# Redis Cache & Real-time PubSub
# When deploying via docker-compose.prod.yml, the host is 'redis'
REDIS_URL=redis://redis:6379

# Cryptographic Secrets (Generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_with_64_char_hex_random_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_64_char_hex_random_secret_for_refresh_tokens
SESSION_SECRET=replace_with_64_char_hex_random_secret_for_express_sessions

# Open-Source Mapping Services (NO Google Cloud / Google Maps keys required)
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Emergency SMS Gateway (Mock or Production SMS provider such as MSG91 / Twilio)
SMS_PROVIDER_API_KEY=mock_production_sms_key
SMS_SENDER_ID=NDMAIND

# AI Copilot Provider (Optional - Gemini / Anthropic / Local LLM)
AI_PROVIDER_API_KEY=mock_production_ai_key
AI_MODEL_NAME=gemini-1.5-pro

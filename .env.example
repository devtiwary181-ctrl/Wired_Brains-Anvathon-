PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://disasterready:disasterready_secret@localhost:5432/disasterready_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT & Session Security
JWT_SECRET=super_secret_jwt_key_for_disasterready_development_only_change_in_prod
SESSION_SECRET=session_signing_secret_key_development_32chars_min

# External Integrations
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
SMS_PROVIDER_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=NDMAIND
AI_PROVIDER_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-pro

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=disasterready-india
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@disasterready-india.iam.gserviceaccount.com

PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://disasterready:disasterready_secret@localhost:5432/disasterready_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT & Session Security
JWT_SECRET=super_secret_jwt_key_for_disasterready_development_only_change_in_prod
SESSION_SECRET=session_signing_secret_key_development_32chars_min

# Mapping Tile Services (ArcGIS World Street primary + CARTO fallback)
# Zero OpenStreetMap volunteer server traffic or API keys required
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
MAP_TILE_FALLBACK_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png

# Optional legacy keys (Not required)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_BROWSER_API_KEY=
ROUTE_RISK_W1=0.35
ROUTE_RISK_W2=0.25
ROUTE_RISK_W3=0.20
ROUTE_RISK_W4=0.10
ROUTE_RISK_W5=0.10
SMS_PROVIDER_API_KEY=your_sms_gateway_api_key_here
SMS_SENDER_ID=NDMAIND
AI_PROVIDER_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL_NAME=gemini-1.5-pro

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=disasterready-india
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@disasterready-india.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
